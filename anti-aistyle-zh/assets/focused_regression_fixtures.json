    },
    {
      "id": "F05",
      "category": "focused_fiction_reunion_scene",
      "groups": ["focused_residuals", "c1_residual"],
      "text_type": "fiction",
      "call_mode": "default_only",
      "risk_tags": ["旧人重逢", "短 scene", "物件盖章", "成熟感伤页"],
      "input": "药店门口的雨棚窄得很，她递过来一张纸巾，说你脸上有水。他接过去，没有擦，只攥在手里。两个人隔着一辆送药的电动车站着，谁也没问后来过得怎么样。她笑了一下，说自己还住在老地方。他点点头，把纸巾折好塞进口袋。多年以后他们终于明白，成年人能给彼此留下的，也不过是这样一小点没有说破的体面。",
      "assertions": {
        "remove_patterns": ["多年以后他们终于明白", "成年人能给彼此留下的", "没有说破的体面"],
        "forbid_patterns": ["成年人终于", "彼此位置", "多年以后", "没有说破的体面", "像一枚印章"],
        "preserve_keywords": ["药店门口", "纸巾", "送药的电动车", "老地方"],
        "require_any_patterns": ["雨棚", "电动车", "没问", "口袋", "药店"],
        "max_added_details": 1,
        "max_total_pattern_groups": [
          {
            "label": "reunion_seal",
            "patterns": ["成年人", "多年以后", "体面", "终于明白", "彼此位置", "盖章"],
            "max_total": 0
          }
        ]
      }
    },
    {
      "id": "F03",
      "category": "focused_outline_volume_group",
      "groups": ["focused_residuals", "d4_residual"],
      "text_type": "outline",
      "call_mode": "default_only",
      "risk_tags": ["卷群结构文件", "工作块感不足", "长段说明 prose"],
      "input": "卷五到卷八真正要写的，是北岸计划如何从改造项目慢慢显出持续重编的本体。团队先顺着资料柜去向摸到总站外围，再通过批次代码册确认每个批次同时改空间、称呼和叙述口径。接着写仓道勘验，让同一辆配送车同时送门牌、广播卡带和标准文稿，坐实接口维护不是后勤而是分发中枢。后半卷再把争论压回队内，第零批次和当前批次两条线只能先押一头，最后露出“口径校正”四个字收尾。",
      "assertions": {
        "require_any_patterns": ["入口", "卡口", "分歧", "收法", "证据", "速记", "回填", "两头", "先押一头", "不要讲圆"],
        "forbid_patterns": ["真正要写的", "坐实", "不是后勤而是", "最后露出", "收尾", "真正的本体"],
        "min_nonempty_lines": 5,
