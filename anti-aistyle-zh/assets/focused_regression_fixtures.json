      "text_type": "fiction",
      "call_mode": "default_only",
      "risk_tags": ["遗物触发", "短 scene", "人物通性回补", "意义尾句回潮"],
      "input": "她把柜子里那件旧外套抱出来，又拆开红绳布包。里面是一把黄铜钥匙和一张便签，字抖得厉害：厨房窗台下面，别让你舅知道。她盯着那两行字，鼻子一下发酸。这确实像母亲会做的事，嘴上从来不说，重要的东西总藏在这些琐碎地方。她知道自己回家以后还得把窗台下面翻出来，可门一合上，她还是忍不住想，母亲没说完的话，大概都留在这把钥匙里了。",
      "assertions": {
        "remove_patterns": ["这确实像母亲会做的事", "重要的东西总藏在", "没说完的话", "都留在这把钥匙里"],
        "forbid_patterns": ["这确实像她", "她向来如此", "重要的东西", "没说完的话", "这意味着"],
        "preserve_keywords": ["旧外套", "黄铜钥匙", "便签", "厨房窗台下面", "回家"],
        "require_any_patterns": ["走廊", "呼叫铃", "滚轮", "柜门", "掌心", "回家"],
        "max_added_details": 1,
        "nonincreasing_patterns": ["她知道", "她向来", "这确实像", "没说完的话"],
        "max_total_pattern_groups": [
          {
            "label": "relic_scene_meaning",
            "patterns": ["像她", "像母亲", "向来", "重要的东西", "没说完的话", "这意味着"],
            "max_total": 0
          }
        ]
      }
    },
    {
      "id": "F02",
      "category": "focused_profile_service_worker",
      "groups": ["focused_residuals", "b2_residual"],
      "text_type": "narrative",
      "call_mode": "default_only",
      "risk_tags": ["服务劳动者人物稿", "整日跟拍模板", "稳妥认可壳"],
      "input": "六点四十多，他从水站出来，先跑家属院，再去培训机构，中午回站核单，下午跑几户散单，傍晚收工前把车上的灰掸一遍。一路上他不多说话，只是一桶一桶往上送。熟客都知道，他这人靠得住，事情交到他手里，心里就稳了。要是问他累不累，他多半还是那句：累也得一桶一桶送。",
      "assertions": {
        "remove_patterns": ["靠得住", "心里就稳了", "要是问他累不累"],
        "forbid_patterns": ["每天都是这个点", "到了中午", "傍晚收工前", "要是问他", "还是那句", "靠得住", "让人服气"],
